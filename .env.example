# Gemini (feature 004). Get a key at https://aistudio.google.com
GEMINI_API_KEY=
# Newest fast model (2026-11-12); falls back automatically if unavailable
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# MINIMAL | LOW | MEDIUM | HIGH | XHIGH (lower = faster)
GEMINI_THINKING_LEVEL=LOW
